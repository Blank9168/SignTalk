{
  "name": "sign-talk-api",
  "version": "1.0.0",
  "description": "Backend API for SignTalk -- dictionary CRUD, user accounts, recognition logs, and model version info.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:dictionary": "node src/scripts/seedDictionary.js",
    "seed:model-version": "node src/scripts/registerModelVersion.js",
    "test": "jest --runInBand",
    "lint": "node --check src/server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
