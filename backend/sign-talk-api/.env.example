# Copy this file to .env and fill in real values for your environment.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local dev: run `docker compose up -d` (see docker-compose.yml) and use the line below.
MONGODB_URI=mongodb://localhost:27017/signtalk
# Or point this at a MongoDB Atlas free-tier cluster instead of running Mongo locally.

# --- Firebase Admin (verifies ID tokens issued by the Android app's Firebase Auth) ---
# Get these three values from your Firebase project's service account JSON
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences literal (don't turn them into real newlines) --
# dotenv reads this as one line and firebase.js un-escapes it at startup.
FIREBASE_PRIVATE_KEY=

# --- Dev-only auth bypass ---
# When true AND NODE_ENV !== "production", every request is treated as
# logged in as a fake dev user (see src/middleware/auth.js) instead of
# verifying a real Firebase token. Useful for testing this API before the
# Firebase project / Android auth flow is wired up. NEVER set this in
# production -- the server refuses to start with it set if NODE_ENV=production.
AUTH_DEV_BYPASS=true

# --- Admin bootstrapping ---
# Comma-separated emails that get role="admin" the first time they sync
# via POST /api/users/sync (see src/controllers/users.controller.js).
ADMIN_EMAILS=

# --- Used by scripts/registerModelVersion.js only ---
# Path to the ai/models/metadata.json produced by ai/training/train.py.
# Default assumes the standard repo layout (backend/sign-talk-api sibling of ai/).
AI_MODELS_METADATA_PATH=../../ai/models/metadata.json
