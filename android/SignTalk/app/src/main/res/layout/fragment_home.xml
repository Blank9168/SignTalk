<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Top bar: app name + settings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Time-of-day FSL greeting, set in HomeFragment. -->
                <TextView
                    android:id="@+id/timeGreetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Magandang araw"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SignTalk"
                    android:textAppearance="@style/TextAppearance.SignTalk.ToolbarTitle"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.SignTalk.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Settings"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:icon="@drawable/ic_settings"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Hero banner. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/brand_gradient_center"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_badge_on_brand"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/img_logo_mark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Talk with your hands.\nBe understood."
                    android:textAppearance="@style/TextAppearance.SignTalk.Display"
                    android:textColor="@color/on_brand"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Recognizes selected FSL and ASL signs"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_brand_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_on_brand"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="50 signs"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/on_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_on_brand"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="FSL + ASL"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/on_brand" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_on_brand"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="On-device"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/on_brand" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="Get started"
            android:textAppearance="@style/TextAppearance.SignTalk.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recognitionCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:contentDescription="Recognize Sign. Sign to the camera"
                android:focusable="true"
                android:minHeight="148dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        style="@style/SignTalk.IconBadge"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_badge_solid_primary"
                        android:src="@drawable/ic_videocam"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Recognize Sign"
                        android:textAppearance="@style/TextAppearance.SignTalk.CardTitle"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sign to the camera"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/translateCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:contentDescription="Text / Speech to Sign. Type or say a word"
                android:focusable="true"
                android:minHeight="148dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        style="@style/SignTalk.IconBadge"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_badge_secondary"
                        android:src="@drawable/ic_record_voice"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Text / Speech to Sign"
                        android:textAppearance="@style/TextAppearance.SignTalk.CardTitle"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Type or say a word"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dictionaryCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:contentDescription="Dictionary. Browse all 50 signs"
                android:focusable="true"
                android:minHeight="148dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        style="@style/SignTalk.IconBadge"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_badge_tertiary"
                        android:src="@drawable/ic_book"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Dictionary"
                        android:textAppearance="@style/TextAppearance.SignTalk.CardTitle"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Browse all 50 signs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/addSignCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:contentDescription="Add a Sign. Save a sign, send it for review"
                android:focusable="true"
                android:minHeight="148dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        style="@style/SignTalk.IconBadge"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_badge_primary"
                        android:src="@drawable/ic_add"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Add a Sign"
                        android:textAppearance="@style/TextAppearance.SignTalk.CardTitle"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Save a sign, send it for review"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Quick tip + tutorial. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_info_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Good light. Hands inside the frame."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tutorialButton"
                style="@style/Widget.SignTalk.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="How to use"
                app:icon="@drawable/ic_school" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
