<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pill behind the selected bottom-navigation icon. -->
    <style name="Widget.SignTalk.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Filter chips on the dictionary screen. -->
    <style name="Widget.SignTalk.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- Example-phrase chips on the Translate screen. -->
    <style name="Widget.SignTalk.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">100dp</item>
        <item name="chipIcon">@drawable/ic_record_voice</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipIconVisible">true</item>
    </style>

    <!-- Icon buttons sitting on the dark transcript bar over the camera. -->
    <style name="SignTalk.OverlayIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/on_brand</item>
    </style>

    <!-- Labelled text button on the dark camera overlay (icon + word, 48dp tall). -->
    <style name="Widget.SignTalk.Button.Overlay" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SignTalk.Button</item>
    </style>

    <!-- Recognition screen control row: icon above a short label, 64dp tall targets. -->
    <style name="Widget.SignTalk.Button.Control" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">24dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <!-- Big status pill on the recognition screen (Detecting / Recognized / Not sure / Unknown). -->
    <style name="SignTalk.StatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
