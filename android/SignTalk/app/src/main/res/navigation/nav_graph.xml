<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.signtalk.ui.splash.SplashFragment"
        android:label="SignTalk"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.signtalk.ui.home.HomeFragment"
        android:label="SignTalk"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_recognition"
            app:destination="@id/recognitionFragment" />
        <action
            android:id="@+id/action_home_to_dictionary"
            app:destination="@id/dictionaryListFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/recognitionFragment"
        android:name="com.example.signtalk.ui.recognition.RecognitionFragment"
        android:label="Sign to Text &amp; Speech"
        tools:layout="@layout/fragment_recognition" />

    <fragment
        android:id="@+id/dictionaryListFragment"
        android:name="com.example.signtalk.ui.dictionary.DictionaryListFragment"
        android:label="FSL Dictionary"
        tools:layout="@layout/fragment_dictionary_list">
        <action
            android:id="@+id/action_dictionaryList_to_detail"
            app:destination="@id/dictionaryDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/dictionaryDetailFragment"
        android:name="com.example.signtalk.ui.dictionary.DictionaryDetailFragment"
        android:label="Sign"
        tools:layout="@layout/fragment_dictionary_detail">
        <argument
            android:name="entryId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.signtalk.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
