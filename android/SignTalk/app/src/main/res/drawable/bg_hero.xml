<?xml version="1.0" encoding="utf-8"?>
<!-- Home hero banner background. The parent MaterialCardView clips it to rounded corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_brand_gradient" />
    <!-- Two soft "ripples" in the top-right corner: a quiet nod to sound / speech. -->
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:right="-70dp"
        android:top="-90dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_glow_soft" />
        </shape>
    </item>
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="top|end"
        android:right="-30dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand_glow" />
        </shape>
    </item>
</layer-list>
