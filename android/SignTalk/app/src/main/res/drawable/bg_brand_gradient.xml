<?xml version="1.0" encoding="utf-8"?>
<!-- Teal brand gradient, top-left (light) to bottom-right (dark). Used full-bleed on the splash screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/brand_gradient_center"
        android:endColor="@color/brand_gradient_end"
        android:startColor="@color/brand_gradient_start"
        android:type="linear" />
</shape>
